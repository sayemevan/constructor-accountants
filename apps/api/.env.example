# Copy to apps/api/.env for local development. Values match infrastructure/compose/dev.yml (dev-only credentials).
# Every variable is validated at boot by src/core/config/app-config.ts; the full production list is in
# ai-context/17-deployment-architecture.md.

NODE_ENV=development
DEPLOYMENT_MODE=saas
APP_BASE_URL=http://localhost:3000
PORT=3001
LOG_LEVEL=debug
# Behind a reverse proxy set to true / hop count / subnet list, so client IPs and X-Request-Id are trusted.
TRUST_PROXY=false
# Local development only: include internal error messages in 500 responses. Refused in any other NODE_ENV.
EXPOSE_ERROR_DETAILS=false

# Runtime role: DML only, subject to row-level security.
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/construction_erp
# Owner role: used only by `prisma migrate` / `cli.js migrate`.
DATABASE_MIGRATION_URL=postgresql://app_owner:app_owner@localhost:5432/construction_erp
DATABASE_POOL_SIZE=10

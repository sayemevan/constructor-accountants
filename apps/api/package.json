{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "dev:worker": "prisma generate && nest start --watch --entryFile worker --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "db:generate": "prisma generate && prisma generate --schema src/core/tenancy/__tests__/spike/schema.prisma",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "pnpm db:generate && eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "pnpm db:generate && vitest run --config vitest.int.config.ts",
    "perf:tenancy": "pnpm db:generate && vitest run --config vitest.int.config.ts --mode perf"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/contracts": "workspace:*",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@repo/config": "workspace:*",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}

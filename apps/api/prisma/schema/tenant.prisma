// Module `tenant` (ai-context/modules/tenant-management.md, 05 §3 Core, 06).

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("tenant_status")
}

/// Global table (no tenant_id, no RLS): one row per construction company. Access is guarded by the tenant module —
/// its repository always filters by the id from TenantContext. Never hard-deleted (app roles have no DELETE).
model Tenant {
  /// UUIDv7 generated by TenantService before provisioning: the new tenant's context needs the id up front.
  id           String       @id @db.Uuid
  name         String
  legalName    String?      @map("legal_name")
  /// Unique platform-wide, lowercase, immutable after creation (CHECK in the migration).
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  baseCurrency String       @map("base_currency") @db.Char(3)
  timezone     String
  locale       String
  countryCode  String?      @map("country_code") @db.Char(2)
  taxId        String?      @map("tax_id")
  addressLine1 String?      @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String?
  region       String?
  postalCode   String?      @map("postal_code")
  phone        String?
  email        String?
  /// → files.id once the files module exists (Phase 2).
  logoFileId   String?      @map("logo_file_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int          @default(1)

  settings        TenantSettings?
  numberSequences NumberSequence[]
  outboxEvents    OutboxEvent[]

  @@map("tenants")
}

/// Tenant-owned (RLS): the company's typed settings blob, validated by the versioned Zod schema in
/// @repo/contracts (TenantSettings). One row per tenant, created with the tenant.
model TenantSettings {
  /// DB default reads the transaction-local tenant, so callers never pass tenantId (06 rule 2).
  tenantId      String   @id @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid")) @map("tenant_id") @db.Uuid
  settings      Json
  /// Version of the settings *schema* the blob was written with (upgraded on read).
  schemaVersion Int      @map("schema_version")
  /// Optimistic-locking version of the row.
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}
